                "oldPassword"
            ],
            "properties": {
                "newPassword": {
                    "type": "string"
                },
                "oldPassword": {
                    "type": "string"
                }
            }
        },
        "model.User": {
            "type": "object",
            "required": [
                "id",
                "username"
            ],
            "properties": {
                "avatar": {
                    "description": "用户头像、创建时；为空字符串",
                    "type": "string"
                },
                "createAt": {
                    "type": "string"
                },
                "id": {
                    "description": "用户 ID",
                    "allOf": [
                        {
                            "$ref": "#/definitions/model.UserID"
                        }
                    ],
                    "example": 1
                },
                "nickname": {
                    "description": "用户中文名称，默认为 ‘’，可后期通过修改用户信息设置",
                    "type": "string"
                },
                "updateAt": {
                    "type": "string"
                },
                "username": {
                    "description": "用户账户；创建时使用；后期不可修改。",
                    "type": "string",
                    "example": "whx"
                }
            }
        },
        "model.UserID": {
            "type": "integer",
            "enum": [
                0
            ],
            "x-enum-varnames": [
                "InvalidUserID"
            ]

                    "example": 1
                },
                "nickname": {
                    "description": "用户中文名称，默认为 ‘’，可后期通过修改用户信息设置",
                    "type": "string"
                },
                "token": {
                    "description": "认证令牌",
                    "type": "string"
                },
                "updateAt": {
                    "type": "string"
                },
                "username": {
                    "description": "用户账户；创建时使用；后期不可修改。",
                    "type": "string",
                    "example": "whx"
                }
            }
        },
        "utils.KResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "data": {},
                "message": {
                    "type": "string"
                }
            }
        }

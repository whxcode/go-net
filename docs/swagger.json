            "type": "object",
            "required": [
                "id",
                "token",
                "username"
            ],
            "properties": {
                "avatar": {
                    "description": "用户头像、创建时；为空字符串",
                    "type": "string"
                },
                "createAt": {
                    "type": "string"
                },
                "id": {
                    "description": "用户 ID",
                    "allOf": [
                        {
                            "$ref": "#/definitions/model.UserID"
